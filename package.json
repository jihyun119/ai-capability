{
  "name": "ai-capability-diagnosis",
  "version": "0.1.0",
  "description": "POOKIE, a three-track web assessment for practical AI capability",
  "private": true,
  "type": "module",
  "homepage": "https://ai-capability-green.vercel.app/",
  "repository": {
    "type": "git",
    "url": "https://github.com/jihyun119/ai-capability.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "track1:backend": "node scripts/track1-backend-evaluate.js",
    "track1:backend:sample": "node scripts/track1-backend-evaluate.js examples/track1/sample_success.json --questionnaire examples/track1/sample_questionnaire_answers.json",
    "track1:e2e": "node scripts/track1-e2e-test.js",
    "track2:test": "node scripts/track2-test-scorer.js",
    "track2:e2e": "node scripts/track2-e2e-test.js",
    "track3:demo": "node scripts/track3-demo-test.js",
    "frontend:preview": "node frontend/preview-server.cjs",
    "test": "node --test test/*.test.*"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.6",
    "openai": "^4.52.0"
  }
}
